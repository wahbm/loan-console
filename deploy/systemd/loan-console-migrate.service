[Unit]
Description=Loan Console MariaDB migrations
After=network.target mariadb.service

[Service]
Type=oneshot
User=loan-console
Group=loan-console
WorkingDirectory=/srv/loan-console/current
EnvironmentFile=/etc/loan-console/loan-console-migrate.env
ExecStart=/usr/bin/node /srv/loan-console/current/apps/api/dist/cli/migrate.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/loan-console/persistent

[Install]
WantedBy=multi-user.target
